# 不要把真实 key 上传到 GitHub。Railway 里用 Variables 配置。

# API-FOOTBALL / API-SPORTS
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# TheStatsAPI
THESTATS_API_KEY=your_thestats_key_here
THESTATS_BASE_URL=https://api.thestatsapi.com/api
THESTATS_FIXTURE_DAY_CACHE_TTL_SECONDS=600

# The Odds API: primary company-level prematch timeline candidate.
# Historical access requires a paid plan. Never commit the real key.
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
THE_ODDS_API_REGIONS=fi,eu
THE_ODDS_API_BOOKMAKERS=
THE_ODDS_API_OPENING_LOOKBACK_DAYS=7
THE_ODDS_API_OPENING_SCAN_HOURS=12
THE_ODDS_API_MAX_HISTORY_REQUESTS=48
THE_ODDS_API_MIN_1X2_BOOKMAKERS=5
THE_ODDS_API_MIN_AH_BOOKMAKERS=3
THE_ODDS_API_MIN_OU_BOOKMAKERS=3

# Optional legacy iSports, only if available later
ISPORTS_API_KEY=
ISPORTS_BASE_URL=http://isports.feijing88.com

REQUEST_TIMEOUT=30

# Shadow V4-compatible pipeline. Mount a Railway volume at /data.
SNAPSHOT_STORE_PATH=/data/shadow_snapshots.json
SNAPSHOT_STORE_WARN_BYTES=268435456
SNAPSHOT_STORE_MAX_DECOMPRESSED_BYTES=536870912
FUNDAMENTAL_VERSION_RETENTION=100
PORTFOLIO_RUN_RETENTION=100
AUTO_SNAPSHOT_ENABLED=true
AUTO_SNAPSHOT_POLL_SECONDS=300
AUTO_SNAPSHOT_WINDOW_SECONDS=600
AUTO_SNAPSHOT_DAYS_AHEAD=2
UVICORN_WORKERS=1
SHADOW_ACCESS_TOKEN=
LEARNING_DISCOVERY_HORIZON_HOURS=24
LEARNING_POSTMATCH_LOOKBACK_HOURS=36
LEARNING_RESEARCH_PROPOSAL_MIN_MATCHES=5
LEARNING_RESEARCH_PROPOSAL_MIN_FAILURES=3
LEARNING_RESEARCH_PROPOSAL_MIN_FAILURE_RATE=0.25
LEARNING_MAJOR_LEAGUES_VERSION=2026-10-08-v1
LEARNING_NODE_LEASE_SECONDS=900
LEARNING_NODE_RETRY_BASE_SECONDS=300
LEARNING_NODE_RETRY_MAX_SECONDS=3600
LEARNING_NODE_ATTEMPT_RETENTION=5000
LEARNING_RULES_VERSION=MODEL_RULES.md@2026-10-08-v2.15

# Optional A-grade real-funds feeds. Empty registry means every claimed Money%/Bet% packet is rejected.
# Map evidence hostname to a stable registry id and explicitly allowed source types.
REAL_MONEY_MAX_AGE_SECONDS=21600
REAL_MONEY_SOURCE_REGISTRY_JSON={"exchange.example":{"registry_id":"exchange-1","allowed_types":["betting_exchange"]}}

# Nami / SportNanoAPI (requires both values)
NAMI_API_USER=
NAMI_API_SECRET=
NAMI_API_BASE_URL=https://open.sportnanoapi.com
NAMI_REQUEST_TIMEOUT=10
