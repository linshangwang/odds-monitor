# 不要把真实 key 上传到 GitHub。Railway 里用 Variables 配置。

# API-FOOTBALL / API-SPORTS
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# TheStatsAPI
THESTATS_API_KEY=your_thestats_key_here
THESTATS_BASE_URL=https://api.thestatsapi.com/api

# Optional legacy iSports, only if available later
ISPORTS_API_KEY=
ISPORTS_BASE_URL=http://isports.feijing88.com

REQUEST_TIMEOUT=30

# Shadow V4-compatible pipeline. Mount a Railway volume at /data.
SNAPSHOT_STORE_PATH=/data/shadow_snapshots.json
FUNDAMENTAL_VERSION_RETENTION=100
PORTFOLIO_RUN_RETENTION=100
AUTO_SNAPSHOT_ENABLED=true
AUTO_SNAPSHOT_POLL_SECONDS=300
AUTO_SNAPSHOT_WINDOW_SECONDS=600
AUTO_SNAPSHOT_DAYS_AHEAD=2
SHADOW_ACCESS_TOKEN=

# Nami / SportNanoAPI (requires both values)
NAMI_API_USER=
NAMI_API_SECRET=
NAMI_API_BASE_URL=https://open.sportnanoapi.com
NAMI_REQUEST_TIMEOUT=10
